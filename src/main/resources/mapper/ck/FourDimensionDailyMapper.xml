<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dunwugudao.replay.mapper.ck.FourDimensionDailyMapper">

    <resultMap id="BaseResultMap" type="com.dunwugudao.replay.entity.FourDimensionDaily">
        <id column="trade_date" property="tradeDate"/>
        <result column="tech" property="tech"/>
        <result column="sentiment" property="sentiment"/>
        <result column="fund" property="fund"/>
        <result column="policy" property="policy"/>
        <result column="composite" property="composite"/>
        <result column="worth_trade" property="worthTrade"/>
        <result column="phase" property="phase"/>
        <result column="absolute" property="absolute"/>
        <result column="relative" property="relative"/>
        <result column="suggestion" property="suggestion"/>
        <result column="note" property="note"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO four_dimension_daily
            (trade_date, tech, sentiment, fund, policy, composite, worth_trade,
             phase, absolute, relative, suggestion, note)
        VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.tradeDate}, #{e.tech}, #{e.sentiment}, #{e.fund}, #{e.policy}, #{e.composite},
             #{e.worthTrade}, #{e.phase}, #{e.absolute}, #{e.relative}, #{e.suggestion}, #{e.note})
        </foreach>
    </insert>

    <select id="selectByTradeDate" resultMap="BaseResultMap">
        SELECT trade_date, tech, sentiment, fund, policy, composite, worth_trade,
               phase, absolute, relative, suggestion, note
        FROM four_dimension_daily FINAL
        WHERE trade_date = #{tradeDate}
    </select>

</mapper>
